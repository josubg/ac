[node name="DescrLabel" type="RichTextLabel" parent="PanelContainer/MarginContainer/VBoxContainer/MarginContainer" unique_id=1635390298]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 20
text = "El Convento de San Plácido, fundado en 1624 por Jerónimo de Villanueva para una comunidad de monjas benedictinas, es uno de los edificios religiosos más singulares del Madrid de los Austrias. Su iglesia, construida en el siglo XVII bajo la dirección de fray Lorenzo de San Nicolás, conserva intacta su arquitectura de transición entre el Renacimiento y el Barroco. Sin embargo, la fama del convento se debe también al célebre proceso inquisitorial que lo sacudió en 1628, cuando varias religiosas, incluida su fundadora Teresa Valle de la Cerda, afirmaron sufrir posesiones demoníacas y protagonizaron episodios místicos que suscitaron una gran controversia. La Inquisición investigó el caso y procesó a las monjas, a sus confesores y a diversos personajes vinculados al convento, entre ellos su protector Jerónimo de Villanueva. El principal acusado fue fray Francisco García Calderón, confesor de la comunidad, condenado finalmente por delitos relacionados con las corrientes alumbradistas y por conductas impropias en el ejercicio de su ministerio."

