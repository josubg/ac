[node name="DescriptionLabel" type="Label" parent="Panel/PanelContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Excelencia, traigo nuevas que podrían agitar las aguas de la Corte: se murmura que el acero que dio muerte al Conde de Villamediana no fue movido por razón de Estado, sino por celos de amante despechado. El testimonio es reciente, y aún incierto, mas es cosa grave. ¿Ordenáis que se envíe discreto pesquisidor a indagar, o que se deje el rumor morir por sí solo?"
autowrap_mode = 2
